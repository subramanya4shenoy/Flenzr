# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flenzr

# Supabase Managed Services Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3210","http://127.0.0.1:3210","https://flenzr.com","https://app.flenzr.com"]

# Instagram API with Instagram Login (Instagram product credentials, not Facebook Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v26.0
# Fernet key used only on the backend to encrypt persisted social access tokens.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# YouTube account connection (server-only)
YOUTUBE_OAUTH_CLIENT_FILE=.secrets/youtube-oauth-client.json
YOUTUBE_REDIRECT_URI=http://localhost:3210/api/social/youtube/callback

# New Meta apps use Unified Login; Meta app credentials above apply.
INSTAGRAM_LOGIN_MODE=unified
INSTAGRAM_CONFIG_ID=your-facebook-login-for-business-configuration-id

# LinkedIn member profile connection (Sign In with LinkedIn using OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain/api/social/linkedin/callback
# Reuse SOCIAL_TOKEN_ENCRYPTION_KEY above; do not rotate it for this integration.

# X OAuth 2.0 Web App credentials (not OAuth 1.0 API key/secret)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-domain/api/social/x/callback
# Reuse the existing SOCIAL_TOKEN_ENCRYPTION_KEY.

# Facebook Pages: separate Facebook Login for Business configuration (User token + Page assets).
# Leave both app credential fields blank to reuse the Instagram Meta app credentials above.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=
FACEBOOK_REDIRECT_URI=https://your-domain/api/social/facebook/callback
FACEBOOK_API_VERSION=v26.0
# Reuse SOCIAL_TOKEN_ENCRYPTION_KEY. See docs/FACEBOOK_CONNECTION.md.

# Notifications: captured locally until SMTP is explicitly configured.
NOTIFICATION_EMAIL_TRANSPORT=sink
NOTIFICATION_MAIL_SINK=.mail-sink
NOTIFICATION_APP_ORIGIN=http://localhost:3210
NOTIFICATION_EMAIL_FROM=Flenzr <notifications@flenzr.test>
# NOTIFICATION_EMAIL_TRANSPORT=smtp
# NOTIFICATION_SMTP_HOST=
# NOTIFICATION_SMTP_PORT=587
# NOTIFICATION_SMTP_USERNAME=
# NOTIFICATION_SMTP_PASSWORD=
# NOTIFICATION_SMTP_STARTTLS=true
# NOTIFICATION_SMTP_SSL=false
# For implicit TLS on port 465: SSL=true and STARTTLS=false.
# Check setup without sending: ./check-notification-email.sh

# New enquiry protections (rolling 24-hour windows; retries retain request_id).
ENQUIRY_SEND_COOLDOWN_SECONDS=30
ENQUIRY_CREATOR_DAILY_LIMIT=3
ENQUIRY_BLOCK_DUPLICATES=true

# Dedicated private Supabase bucket; provision using scripts/setup_collaboration_storage.py
COLLABORATION_STORAGE_BUCKET=collaboration-files
# 50 MiB default. Increase only with matching project upload limits and bucket setup.
COLLABORATION_FILE_MAX_BYTES=52428800

# Shared live chat transport. Required for multiple API workers/instances.
# Use a private authenticated Redis service (rediss:// for TLS) in deployment.
# Blank uses single-process local chat only. Same URL/namespace on every worker.
CHAT_REDIS_URL=
CHAT_REDIS_NAMESPACE=flenzr:chat
