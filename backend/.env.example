# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flenzr

# Supabase Managed Services Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://flenzr.com"]
