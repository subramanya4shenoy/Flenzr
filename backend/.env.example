# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flenzr

# Supabase Managed Services Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3210","http://127.0.0.1:3210","https://flenzr.com","https://app.flenzr.com"]

# Instagram API with Instagram Login (Instagram product credentials, not Facebook Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v26.0
# Fernet key used only on the backend to encrypt persisted social access tokens.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# YouTube account connection (server-only)
YOUTUBE_OAUTH_CLIENT_FILE=.secrets/youtube-oauth-client.json
YOUTUBE_REDIRECT_URI=http://localhost:3210/api/social/youtube/callback

# New Meta apps use Unified Login; Meta app credentials above apply.
INSTAGRAM_LOGIN_MODE=unified
INSTAGRAM_CONFIG_ID=your-facebook-login-for-business-configuration-id
