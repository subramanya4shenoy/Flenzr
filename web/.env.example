NEXT_PUBLIC_API_URL=http://127.0.0.1:8210/api/v1
BACKEND_API_URL=http://127.0.0.1:8210
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Set APP_ORIGIN to the canonical HTTPS origin when deploying behind a proxy.

# Server-only: enable YouTube Data API v3 in the Google Cloud project.
YOUTUBE_API_KEY=

# Optional WebRTC relay. Comma-separated TURN URLs support UDP/TCP/TLS fallback.
# These NEXT_PUBLIC values are visible to browsers and frozen at build time.
# Use test-limited credentials locally; provision limited-lifetime credentials for release.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
# all = normal direct/relay selection; relay = qualification with TURN required.
NEXT_PUBLIC_CALL_ICE_POLICY=all
